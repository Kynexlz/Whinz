local function RegisterThemeObject(Type, Object, Property)

	if not ThemeObjects[Type] then
		return
	end

	table.insert(ThemeObjects[Type], {
		Object = Object,
		Property = Property
	})

end

local function SetTheme(Name)

	local Theme = Themes[Name]

	if not Theme then
		return
	end

	CurrentTheme = Name

	for Type, Objects in pairs(ThemeObjects) do

		local Color = Theme[Type]

		if Color then

			for _, Info in ipairs(Objects) do

				if Info.Object and Info.Object.Parent then
					Info.Object[Info.Property] = Color
				end

			end

		end

	end

end

