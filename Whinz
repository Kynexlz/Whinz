local Tabs = {}
local CurrentTab

local function SelectTab(Tab)

	CurrentTab = Tab

	for _, OtherTab in ipairs(Tabs) do

		OtherTab.Container.Visible = false

		OtherTab.Button.BackgroundColor3 =
			Themes[CurrentTheme].Tab

	end

	Tab.Container.Visible = true

	Tab.Button.BackgroundColor3 =
		Themes[CurrentTheme].TabSelected

end

--==================================================
-- CREATE TAB
--==================================================

local function CreateTab(TabName)

	local Tab = {}

	Tab.Name = TabName

	-- TAB BUTTON
	local TabButton = Instance.new("TextButton")

	TabButton.Name = TabName
	TabButton.Size = UDim2.new(1, 0, 0, 38)
	TabButton.BorderSizePixel = 0
	TabButton.Text = TabName
	TabButton.TextSize = 13
	TabButton.Font = Enum.Font.GothamMedium
	TabButton.Parent = Sidebar

	RegisterThemeObject("Tab", TabButton, "BackgroundColor3")
	RegisterThemeObject("Text", TabButton, "TextColor3")

	local TabCorner = Instance.new("UICorner")
	TabCorner.CornerRadius = UDim.new(0, 6)
	TabCorner.Parent = TabButton

	Tab.Button = TabButton

	-- TAB CONTENT
	local Container = Instance.new("ScrollingFrame")

	Container.Name = TabName .. "Content"
	Container.Size = UDim2.new(1, 0, 1, 0)
	Container.BackgroundTransparency = 1
	Container.BorderSizePixel = 0
	Container.ScrollBarThickness = 4
	Container.CanvasSize = UDim2.new(0, 0, 0, 0)
	Container.AutomaticCanvasSize = Enum.AutomaticSize.Y
	Container.Visible = false
	Container.Parent = Content

	local Padding = Instance.new("UIPadding")

	Padding.PaddingTop = UDim.new(0, 15)
	Padding.PaddingBottom = UDim.new(0, 15)
	Padding.PaddingLeft = UDim.new(0, 15)
	Padding.PaddingRight = UDim.new(0, 15)

	Padding.Parent = Container

	local Layout = Instance.new("UIListLayout")

	Layout.Padding = UDim.new(0, 8)
	Layout.SortOrder = Enum.SortOrder.LayoutOrder
	Layout.Parent = Container

	Tab.Container = Container

	-- TAB CLICK
	TabButton.MouseButton1Click:Connect(function()
		SelectTab(Tab)
	end)

	--==================================================
	-- BUTTON
	--==================================================

	function Tab:CreateButton(Data)

		local Button = Instance.new("TextButton")

		Button.Name = Data.Name or "Button"
		Button.Size = UDim2.new(1, 0, 0, 42)
		Button.BorderSizePixel = 0
		Button.Text = Data.Name or "Button"
		Button.TextSize = 14
		Button.Font = Enum.Font.GothamMedium
		Button.Parent = Container

		RegisterThemeObject("Element", Button, "BackgroundColor3")
		RegisterThemeObject("Text", Button, "TextColor3")

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 7)
		Corner.Parent = Button

		Button.MouseButton1Click:Connect(function()

			if Data.Callback then
				Data.Callback()
			end

		end)

		return Button
	end

	--==================================================
	-- LABEL
	--==================================================

	function Tab:CreateLabel(Data)

		local Label = Instance.new("TextLabel")

		Label.Name = "Label"
		Label.Size = UDim2.new(1, 0, 0, 35)
		Label.BackgroundTransparency = 1
		Label.Text = Data.Text or "Label"
		Label.TextSize = 14
		Label.Font = Enum.Font.Gotham
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Container

		RegisterThemeObject("SubText", Label, "TextColor3")

		return Label
	end

	--==================================================
	-- TOGGLE
	--==================================================

	function Tab:CreateToggle(Data)

		local Enabled = Data.CurrentValue or false

		local Holder = Instance.new("Frame")

		Holder.Name = "Toggle"
		Holder.Size = UDim2.new(1, 0, 0, 48)
		Holder.BorderSizePixel = 0
		Holder.Parent = Container

		RegisterThemeObject("Element", Holder, "BackgroundColor3")

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 7)
		Corner.Parent = Holder

		local Label = Instance.new("TextLabel")

		Label.Size = UDim2.new(1, -70, 1, 0)
		Label.Position = UDim2.new(0, 12, 0, 0)
		Label.BackgroundTransparency = 1
		Label.Text = Data.Name or "Toggle"
		Label.TextSize = 14
		Label.Font = Enum.Font.GothamMedium
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Holder

		RegisterThemeObject("Text", Label, "TextColor3")

		local ToggleButton = Instance.new("TextButton")

		ToggleButton.Size = UDim2.new(0, 45, 0, 24)
		ToggleButton.Position = UDim2.new(1, -57, 0.5, -12)
		ToggleButton.Text = ""
		ToggleButton.BorderSizePixel = 0
		ToggleButton.Parent = Holder

		local ToggleCorner = Instance.new("UICorner")
		ToggleCorner.CornerRadius = UDim.new(1, 0)
		ToggleCorner.Parent = ToggleButton

		local function Update()

			if Enabled then
				ToggleButton.BackgroundColor3 =
					Themes[CurrentTheme].Accent
			else
				ToggleButton.BackgroundColor3 =
					Color3.fromRGB(90, 90, 90)
			end

			if Data.Callback then
				Data.Callback(Enabled)
			end

		end

		ToggleButton.MouseButton1Click:Connect(function()

			Enabled = not Enabled

			Update()

		end)

		Update()

		return Holder
	end

	--==================================================
	-- SLIDER
	--==================================================

	function Tab:CreateSlider(Data)

		local Minimum = Data.Range and Data.Range[1] or 0
		local Maximum = Data.Range and Data.Range[2] or 100
		local Increment = Data.Increment or 1
		local Value = Data.CurrentValue or Minimum

		local Holder = Instance.new("Frame")

		Holder.Name = "Slider"
		Holder.Size = UDim2.new(1, 0, 0, 65)
		Holder.BorderSizePixel = 0
		Holder.Parent = Container

		RegisterThemeObject("Element", Holder, "BackgroundColor3")

		local Corner = Instance.new("UICorner")
		Corner.CornerRadius = UDim.new(0, 7)
		Corner.Parent = Holder

		local Label = Instance.new("TextLabel")

		Label.Size = UDim2.new(1, -70, 0, 28)
		Label.Position = UDim2.new(0, 12, 0, 3)
		Label.BackgroundTransparency = 1
		Label.Text = Data.Name or "Slider"
		Label.TextSize = 14
		Label.Font = Enum.Font.GothamMedium
		Label.TextXAlignment = Enum.TextXAlignment.Left
		Label.Parent = Holder

		RegisterThemeObject("Text", Label, "TextColor3")

		local ValueLabel = Instance.new("TextLabel")

		ValueLabel.Size = UDim2.new(0, 50, 0, 28)
		ValueLabel.Position = UDim2.new(1, -60, 0, 3)
		ValueLabel.BackgroundTransparency = 1
		ValueLabel.Text = tostring(Value)
		ValueLabel.TextSize = 13
		ValueLabel.Font = Enum.Font.Gotham
		ValueLabel.Parent = Holder

		RegisterThemeObject("SubText", ValueLabel, "TextColor3")

		local Bar = Instance.new("TextButton")

		Bar.Size = UDim2.new(1, -24, 0, 6)
		Bar.Position = UDim2.new(0, 12, 1, -18)
		Bar.BorderSizePixel = 0
		Bar.Text = ""
		Bar.Parent = Holder

		RegisterThemeObject("Tab", Bar, "BackgroundColor3")

		local BarCorner = Instance.new("UICorner")
		BarCorner.CornerRadius = UDim.new(1, 0)
		BarCorner.Parent = Bar

		local Fill = Instance.new("Frame")

		Fill.Size = UDim2.new(
			(Value - Minimum) / (Maximum - Minimum),
			0,
			1,
			0
		)

		Fill.BorderSizePixel = 0
		Fill.Parent = Bar

		RegisterThemeObject("Accent", Fill, "BackgroundColor3")

		local FillCorner = Instance.new("UICorner")
		FillCorner.CornerRadius = UDim.new(1, 0)
		FillCorner.Parent = Fill

		local SliderDragging = false

		local function SetValue(X)

			local Percent = math.clamp(
				(X - Bar.AbsolutePosition.X) /
					Bar.AbsoluteSize.X,
				0,
				1
			)

			local NewValue =
				Minimum + ((Maximum - Minimum) * Percent)

			NewValue =
				math.floor(
					(NewValue - Minimum) / Increment + 0.5
				) * Increment + Minimum

			NewValue = math.clamp(
				NewValue,
				Minimum,
				Maximum
			)

			Value = NewValue

			local NewPercent =
				(Value - Minimum) /
				(Maximum - Minimum)

			Fill.Size =
				UDim2.new(NewPercent, 0, 1, 0)

			ValueLabel.Text = tostring(Value)

			if Data.Callback then
				Data.Callback(Value)
			end

		end

		Bar.MouseButton1Down:Connect(function(X)

			SliderDragging = true

			SetValue(X)

		end)

		UserInputService.InputChanged:Connect(function(Input)

			if SliderDragging
				and Input.UserInputType ==
				Enum.UserInputType.MouseMovement then

				SetValue(Input.Position.X)

			end

		end)

		UserInputService.InputEnded:Connect(function(Input)

			if Input.UserInputType ==
				Enum.UserInputType.MouseButton1 then

				SliderDragging = false

			end

		end)

		return Holder
	end

	table.insert(Tabs, Tab)

	return Tab
end

